# ==================== 基础设置 ====================
# 服务器监听端口（对应 Docker 中的 EXPOSE）
PORT=3000

# 程序数据目录
DATA_DIR=data

# ==================== 认证设置 (核心必填) ====================
# 最高权限的认证令牌。建议使用 `openssl rand -hex 32` 生成一个长随机字符串。
# 以后你访问 API 或前端管理页面时需要用到它。
AUTH_TOKEN=你的自定义长密码_在这里输入

# 动态 Key 的标识前缀，通常保持默认
KEY_PREFIX=sk-

# ==================== 前端与显示 ====================
# 必须与你上传的文件名一致
FRONTEND_PATH=frontend.zip

# 默认时区
GENERAL_TIMEZONE=Asia/Shanghai

# 默认提示词：让 AI 默认用中文回答
DEFAULT_INSTRUCTIONS="Respond in Chinese by default"

# 运行时间显示（建议从 random 改为中文，否则日志看起来会很乱）
DURATION_FORMAT=standard
DURATION_LANGUAGE=chinese

# ==================== 网络与性能 ====================
# 默认代码补全区域
GENERAL_GCPP_HOST=Asia

# 调试模式（如果你已经部署成功，可以改为 false）
DEBUG=true

# 真实额度显示
REAL_USAGE=true

# 安全哈希
SAFE_HASH=true

# ==================== 其他默认配置 ====================
REQUEST_BODY_LIMIT=2000000
REQUEST_LOGS_LIMIT=100
TCP_KEEPALIVE=60
BYPASS_MODEL_VALIDATION=false
MODEL_ID_SOURCE=server_id
CONTEXT_FILL_MODE=1
