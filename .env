# ==================== 基础服务配置 ====================
# 服务器监听端口（容器内部端口，需与 EXPOSE 保持一致）
PORT=3000

# 服务器监听IP（留空默认监听 0.0.0.0）
HOST=

# ==================== 安全与认证 (重要) ====================
# 你的管理员登录令牌，请务必修改为一个复杂的字符串
AUTH_TOKEN=0x3f

# 动态密钥的前缀，通常保持默认
KEY_PREFIX=sk-

# ==================== 前端资源设置 ====================
# 指向你刚才放入仓库的压缩包文件名
FRONTEND_PATH=frontend.zip

# ==================== 时间与日志设置 ====================
# 调试模式：已按要求关闭
DEBUG=false

# 调试日志文件路径（关闭 Debug 后建议保持默认）
DEBUG_LOG_FILE=debug.log

# 运行时间显示语言：已按要求设为英文
DURATION_LANGUAGE=english

# 运行时间显示格式：建议使用 standard 避免 random 导致的格式混乱
DURATION_FORMAT=standard

# 默认时区：建议设为上海
GENERAL_TIMEZONE=Asia/Shanghai

# ==================== 程序逻辑配置 ====================
# 默认提示词：建议让 AI 优先使用中文回答
DEFAULT_INSTRUCTIONS="Respond in Chinese by default"

# 默认代码补全区域，亚洲用户建议填 Asia
GENERAL_GCPP_HOST=Asia

# 数据存储目录
DATA_DIR=data

# 显示真实额度消耗
REAL_USAGE=true

# 开启安全哈希
SAFE_HASH=true

# ==================== 系统高级设置 ====================
# 请求体大小限制（默认 2MB）
REQUEST_BODY_LIMIT=2000000

# 日志储存条数
REQUEST_LOGS_LIMIT=100

# 保持连接参数
TCP_KEEPALIVE=60
TCP_KEEPALIVE_INTERVAL=15
TCP_KEEPALIVE_RETRIES=5

# HTTP2 优化
HTTP2_ADAPTIVE_WINDOW=true
HTTP2_KEEP_ALIVE_INTERVAL=30
HTTP2_KEEP_ALIVE_WHILE_IDLE=true

# 超时设置（秒）
SERVICE_TIMEOUT=30

# 绕过内置模型验证
BYPASS_MODEL_VALIDATION=false

# 模型 ID 来源
MODEL_ID_SOURCE=server_id

# 上下文填充模式
CONTEXT_FILL_MODE=1
